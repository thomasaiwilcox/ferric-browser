+    auto *delegate = contents
+            ? static_cast<WebContentsDelegateQt *>(contents->GetDelegate()) : nullptr;
+    if (!main || !main->IsRenderFrameLive() || !delegate)
+        return false;
+    if (!delegate->mediaActivityCounterBoundaryProbe())
+        return false;
+
+    const url::Origin origin = main->GetLastCommittedOrigin();
+    content::MediaStreamRequest request(
+            main->GetProcess()->GetDeprecatedID(), main->GetRoutingID(), 1, origin, true,
+            blink::MEDIA_GENERATE_STREAM, {}, {"screen:-3:0"},
+            blink::mojom::MediaStreamType::NO_SERVICE,
+            blink::mojom::MediaStreamType::DISPLAY_VIDEO_CAPTURE, false, false, false);
