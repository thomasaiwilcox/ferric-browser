+void WebContentsDelegateQt::beginPendingMediaCaptureForProbe()
+{
+    // A saturated/poisoned count can never certify absence. Bound attacker-
+    // influenced requests instead of allowing the diagnostic count to wrap.
+    if (m_ferricPendingMediaCaptureCount >= 0) {
+        if (m_ferricPendingMediaCaptureCount < 512)
+            ++m_ferricPendingMediaCaptureCount;
+        else
+            m_ferricPendingMediaCaptureCount = -1;
+    }
+
+    if (auto *adapter = webContentsAdapter())
+        adapter->ferricMediaCaptureStartingForProbe();
+}
+
+void WebContentsDelegateQt::endPendingMediaCaptureForProbe()
+{
+    if (m_ferricPendingMediaCaptureCount > 0)
+        --m_ferricPendingMediaCaptureCount;
+}
+
+bool WebContentsDelegateQt::hasNoMediaCaptureActivityForProbe() const
+{
+    return !m_ferricMediaActivityCounterPoisoned
+            && m_ferricPendingMediaCaptureCount == 0 && m_audioStreamCount == 0
+            && m_videoStreamCount == 0 && m_mirroringStreamCount == 0
+            && m_desktopStreamCount == 0;
+}
+
+bool WebContentsDelegateQt::mediaActivityCounterBoundaryProbe()
+{
+    if (!hasNoMediaCaptureActivityForProbe())
+        return false;
+    int pendingCount = 512;
+    if (pendingCount < 512)
+        ++pendingCount;
+    else
+        pendingCount = -1;
+    const bool refusedPendingSaturation = pendingCount < 0;
+    m_audioStreamCount = std::numeric_limits<int>::max();
+    blink::MediaStreamDevice probeDevice(
+            blink::mojom::MediaStreamType::DEVICE_AUDIO_CAPTURE,
+            "ferric-counter-probe", "Ferric counter probe");
+    addDevice(probeDevice);
+    const bool refusedOverflow = m_ferricMediaActivityCounterPoisoned
+            && m_audioStreamCount == std::numeric_limits<int>::max();
+    m_audioStreamCount = 0;
+    m_ferricMediaActivityCounterPoisoned = false;
+    removeDevice(probeDevice);
+    const bool refusedUnderflow = m_ferricMediaActivityCounterPoisoned
+            && m_audioStreamCount == 0;
+    m_ferricMediaActivityCounterPoisoned = false;
+    return refusedPendingSaturation && refusedOverflow && refusedUnderflow
+            && hasNoMediaCaptureActivityForProbe();
