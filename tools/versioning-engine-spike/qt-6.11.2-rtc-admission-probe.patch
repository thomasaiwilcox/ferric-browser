+bool WebContentsAdapter::ferricPreselectedDesktopAdmissionProbe()
+{
+    if (!isInitialized())
+        return false;
+    auto *contents = m_webContents.get();
+    auto *main = contents ? contents->GetPrimaryMainFrame() : nullptr;
+    if (!main || !main->IsRenderFrameLive())
+        return false;
+
+    const url::Origin origin = main->GetLastCommittedOrigin();
+    content::MediaStreamRequest request(
+            main->GetProcess()->GetDeprecatedID(), main->GetRoutingID(), 1, origin, true,
+            blink::MEDIA_GENERATE_STREAM, {}, {"ferric-invalid-desktop-source"},
+            blink::mojom::MediaStreamType::NO_SERVICE,
+            blink::mojom::MediaStreamType::DISPLAY_VIDEO_CAPTURE, false, false, false);
+    bool refused = false;
+    content::MediaResponseCallback callback = base::BindOnce(
+            [](bool *refused, const blink::mojom::StreamDevicesSet &,
+               blink::mojom::MediaStreamRequestResult result,
+               std::unique_ptr<content::MediaStreamUI> ui) {
+        *refused = result == blink::mojom::MediaStreamRequestResult::INVALID_STATE && !ui;
+    }, &refused);
+    MediaCaptureDevicesDispatcher::GetInstance()->processMediaAccessRequest(
+            contents, request, std::move(callback), content::DesktopMediaID());
+    return refused;
+}
