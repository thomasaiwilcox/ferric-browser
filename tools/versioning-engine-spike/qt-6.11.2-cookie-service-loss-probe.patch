@@ -137,4 +137,24 @@ void QWebEngineCookieStore::ferricCookieSyntheticPreflightProbe(
     d->delegate->ferricCookieCloneProbe(destination->d_func()->delegate, false,
                                        std::move(completion), false, fixture);
 }
+
+void QWebEngineCookieStore::ferricCookieServiceLossProbe(
+        QWebEngineCookieStore *destination, FerricServiceLossProbeStage stage,
+        std::function<void(FerricProbeResult)> completion)
+{
+    if (!completion)
+        return;
+    Q_D(QWebEngineCookieStore);
+    if (!destination || destination == this || QThread::currentThread() != thread()
+            || destination->thread() != thread() || !d->delegate
+            || !destination->d_func()->delegate || d->filterCallback
+            || destination->d_func()->filterCallback) {
+        completion({FerricProbeStatus::Unavailable, 0, 0});
+        return;
+    }
+    d->delegate->ferricCookieCloneProbe(destination->d_func()->delegate, false,
+                                       std::move(completion), true,
+                                       FerricSyntheticPreflightCase::None,
+                                       false, false, false, stage);
+}
 
