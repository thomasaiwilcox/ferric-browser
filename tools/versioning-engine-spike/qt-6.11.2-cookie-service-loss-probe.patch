diff --git a/src/3rdparty/chromium/services/network/cookie_manager.cc b/src/3rdparty/chromium/services/network/cookie_manager.cc
--- a/src/3rdparty/chromium/services/network/cookie_manager.cc
+++ b/src/3rdparty/chromium/services/network/cookie_manager.cc
@@ -110,2 +123,19 @@ void CookieManager::GetAllCookies(GetAllCookiesCallback callback) {
+  if (ferric_probe_drop_next_get_all_reply_) {
+    ferric_probe_drop_next_get_all_reply_ = false;
+    // Complete the backing-store operation, but destroy the response callback
+    // and disconnect the Mojo peer before that completion arrives. This is a
+    // disposable in-flight pipe-loss seam, not a network-service crash test.
+    cookie_store_->GetAllCookiesAsync(base::BindOnce(
+        [](GetAllCookiesCallback response, const net::CookieList&) {
+          static_cast<void>(response);
+        },
+        std::move(callback)));
+    receivers_.Clear();
+    return;
+  }
   cookie_store_->GetAllCookiesAsync(std::move(callback));
 }
+
+void CookieManager::FerricProbeDisconnectAfterNextGetAllCookies() {
+  ferric_probe_drop_next_get_all_reply_ = true;
+}
