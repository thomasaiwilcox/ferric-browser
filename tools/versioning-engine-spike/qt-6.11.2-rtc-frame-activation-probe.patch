+QString WebContentsAdapter::ferricFrameActivationSnapshotForProbe() const
+{
+    if (!isInitialized())
+        return QStringLiteral("uninitialized");
+    auto *main = m_webContents->GetPrimaryMainFrame();
+    if (!main)
+        return QStringLiteral("no-primary-main-frame");
+    const auto *primaryPage = &main->GetPage();
+    QString snapshot;
+    m_webContents->ForEachRenderFrameHost([&](content::RenderFrameHost *frame) {
+        if (&frame->GetPage() != primaryPage)
+            return;
+        if (!snapshot.isEmpty())
+            snapshot += QLatin1Char(';');
+        snapshot += QStringLiteral("url=%1 active=%2")
+                .arg(QString::fromStdString(frame->GetLastCommittedURL().spec()))
+                .arg(frame->IsActive() ? 1 : 0);
+    });
+    return snapshot;
+}
