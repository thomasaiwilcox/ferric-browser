+bool WebContentsAdapter::ferricBeginChildFrameCaptureProbe()
+{
+    if (!isInitialized() || m_ferricChildCaptureProbeProcessId >= 0) {
+        qWarning("Ferric child capture probe admission guard: initialized=%d processId=%d",
+                 isInitialized(), m_ferricChildCaptureProbeProcessId);
+        return false;
+    }
+    auto *main = m_webContents->GetPrimaryMainFrame();
+    if (!main) {
+        qWarning("Ferric child capture probe has no primary main frame");
+        return false;
+    }
+    content::RenderFrameHost *child = nullptr;
+    int frameCount = 0;
+    int pageChildCount = 0;
+    m_webContents->ForEachRenderFrameHost([&](content::RenderFrameHost *frame) {
+        ++frameCount;
+        if (frame != main && &frame->GetPage() == &main->GetPage())
+            ++pageChildCount;
+        // Test-only counter injection: the held lease has already frozen this
+        // live child, so do not pretend this is a renderer/device capture.
+        if (!child && frame != main && &frame->GetPage() == &main->GetPage())
+            child = frame;
+    });
+    if (!child) {
+        qWarning("Ferric child capture probe found no same-Page RFH: frames=%d pageChildren=%d",
+                 frameCount, pageChildCount);
+        return false;
+    }
+    m_ferricChildCaptureProbeProcessId = child->GetProcess()->GetDeprecatedID();
+    m_ferricChildCaptureProbeRoutingId = child->GetRoutingID();
+    static_cast<content::RenderFrameHostImpl *>(child)->OnMediaStreamAdded(
+            content::RenderFrameHostImpl::kCapturingMediaStream);
+    const bool frameCapturing = ferricHasFrameCaptureActivityForProbe();
+    const bool noCapture = ferricHasNoMediaCaptureActivityForProbe();
+    qWarning("Ferric child capture probe counter check: frameCapturing=%d noCapture=%d",
+             frameCapturing, noCapture);
+    return frameCapturing && !noCapture;
+}
+
+bool WebContentsAdapter::ferricEndChildFrameCaptureProbe()
+{
+    if (!isInitialized() || m_ferricChildCaptureProbeProcessId < 0
+            || m_ferricChildCaptureProbeRoutingId < 0)
+        return false;
+    const int processId = m_ferricChildCaptureProbeProcessId;
+    const int routingId = m_ferricChildCaptureProbeRoutingId;
+    m_ferricChildCaptureProbeProcessId = -1;
+    m_ferricChildCaptureProbeRoutingId = -1;
+    auto *frame = content::RenderFrameHost::FromID(processId, routingId);
+    if (!frame || content::WebContents::FromRenderFrameHost(frame) != m_webContents.get())
+        return false;
+    static_cast<content::RenderFrameHostImpl *>(frame)->OnMediaStreamRemoved(
+            content::RenderFrameHostImpl::kCapturingMediaStream);
+    return !ferricHasFrameCaptureActivityForProbe()
+            && ferricHasNoMediaCaptureActivityForProbe();
+}
