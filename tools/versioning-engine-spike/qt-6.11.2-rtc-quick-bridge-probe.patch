+bool QQuickWebEngineView::ferricAcquireRtcEmptyLeaseForProbe()
+{
+    if (QThread::currentThread() != thread()) {
+        return false;
+    }
+    auto *d = d_func();
+    if (!d)
+        return false;
+    d->initializeProfile();
+    if (!d->m_profile
+            || !d->m_profile->isOffTheRecord() || !d->adapter
+            || !d->adapter->isInitialized() || d->m_ferricRtcLeaseRelease
+            || d->m_ferricRtcLeaseAcquisitionPending || isVisible()) {
+        return false;
+    }
+    // The native admission operation starts from hidden Active, then requests
+    // Frozen itself before it can retain an empty-registry lease. A previous
+    // probe completion leaves the Quick owner Frozen, so explicitly thaw it
+    // here; never thaw a visible owner or admit from another lifecycle state.
+    if (d->adapter->lifecycleState() == WebContentsAdapter::LifecycleState::Frozen)
+        d->adapter->setLifecycleState(WebContentsAdapter::LifecycleState::Active);
+    else if (d->adapter->lifecycleState() != WebContentsAdapter::LifecycleState::Active)
+        return false;
+    // Keep one outstanding owner request. A second async completion must not
+    // overwrite the first release closure and leak its renderer-side lease.
+    d->m_ferricRtcLeaseAcquisitionPending = true;
+    const quint64 leaseGeneration = ++d->m_ferricRtcLeaseGeneration;
+
+    QPointer<QQuickWebEngineView> owner(this);
+    const QWeakPointer<WebContentsAdapter> expectedAdapter = d->adapter.toWeakRef();
+    d->adapter->ferricRtcAcquireFrozenRegistryLeaseProbe(this,
+            [owner, expectedAdapter, leaseGeneration](bool known, bool registered, int frames, int processes,
+                                     std::function<bool()> valid, std::function<void()> release) mutable {
+        auto complete = [owner, expectedAdapter, leaseGeneration, known, registered, frames, processes,
+                         valid = std::move(valid), release = std::move(release)]() mutable {
+            if (!owner) {
+                if (release)
+                    release();
+                return;
+            }
+            auto *viewPrivate = owner->d_func();
+            if (!viewPrivate || viewPrivate->m_ferricRtcLeaseGeneration != leaseGeneration) {
+                if (release)
+                    release();
+                return;
+            }
+            viewPrivate->m_ferricRtcLeaseAcquisitionPending = false;
+            const auto adapter = expectedAdapter.toStrongRef();
+            const bool exactOwner = adapter && viewPrivate->adapter == adapter;
+            const bool frozenOwner = exactOwner
+                    && owner->lifecycleState() == QQuickWebEngineView::LifecycleState::Frozen
+                    && !owner->isVisible();
+            const bool held = frozenOwner && known && !registered && valid && release && valid();
+            if (held) {
+                viewPrivate->m_ferricRtcLeaseValid = std::move(valid);
+                viewPrivate->m_ferricRtcLeaseRelease = std::move(release);
+            } else if (release) {
+                release();
+            }
+            Q_EMIT owner->ferricRtcEmptyLeaseProbeCompleted(
+                    held || (exactOwner && known && registered), registered && exactOwner,
+                    exactOwner ? frames : 0, exactOwner ? processes : 0);
+        };
+        if (auto *application = QCoreApplication::instance()) {
+            QMetaObject::invokeMethod(application, std::move(complete), Qt::QueuedConnection);
+        } else {
+            complete();
+        }
+    }, [owner, leaseGeneration] {
+        auto invalidate = [owner, leaseGeneration] {
+            if (!owner)
+                return;
+            auto *viewPrivate = owner->d_func();
+            if (!viewPrivate || viewPrivate->m_ferricRtcLeaseGeneration != leaseGeneration)
+                return;
+            const bool hadLease = viewPrivate->releaseFerricRtcProbeLease();
+            if (hadLease)
+                Q_EMIT owner->ferricRtcEmptyLeaseInvalidated();
+        };
+        if (auto *application = QCoreApplication::instance())
+            QMetaObject::invokeMethod(application, std::move(invalidate), Qt::QueuedConnection);
+    });
+    return true;
+}
+
+bool QQuickWebEngineView::ferricRtcEmptyLeaseValidForProbe()
+{
+    if (QThread::currentThread() != thread())
+        return false;
+    auto *d = d_func();
+    if (!d)
+        return false;
+    const auto valid = d->m_ferricRtcLeaseValid;
+    return valid && lifecycleState() == LifecycleState::Frozen
+            && !isVisible() && valid();
+}
+
+bool QQuickWebEngineView::ferricHasNoMediaCaptureActivityForProbe() const
+{
+    if (QThread::currentThread() != thread())
+        return false;
+    auto *d = d_func();
+    return d && d->adapter && d->adapter->ferricHasNoMediaCaptureActivityForProbe();
+}
+
+bool QQuickWebEngineView::ferricHasFrameCaptureActivityForProbe() const
+{
+    if (QThread::currentThread() != thread())
+        return false;
+    auto *d = d_func();
+    return d && d->adapter && d->adapter->ferricHasFrameCaptureActivityForProbe();
+}
+
+void QQuickWebEngineView::ferricReleaseRtcEmptyLeaseForProbe()
+{
+    if (QThread::currentThread() != thread())
+        return;
+    auto *d = d_func();
+    if (!d)
+        return;
+    d->releaseFerricRtcProbeLease();
+}
