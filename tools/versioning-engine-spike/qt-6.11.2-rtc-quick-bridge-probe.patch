+bool QQuickWebEngineViewPrivate::releaseFerricRtcProbeLease()
+{
+    ++m_ferricRtcLeaseGeneration;
+    const bool hadProbeState = bool(m_ferricRtcLeaseValid)
+            || bool(m_ferricRtcLeaseRelease) || m_ferricRtcLeaseAcquisitionPending;
+    m_ferricRtcLeaseAcquisitionPending = false;
+    auto release = std::move(m_ferricRtcLeaseRelease);
+    m_ferricRtcLeaseValid = {};
+    if (release)
+        release();
+    return hadProbeState;
+}
