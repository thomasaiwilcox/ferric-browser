+// Intentionally observation-only. A late subscription, pending renderer IPC,
+// closed-but-not-removed connection or frame replacement defeats absence proof.
+// No URL, RTC configuration, SDP, ICE data, updates or stats are retained.
+class FerricRtcProbeObserver final : public content::PeerConnectionTrackerHostObserver
+{
+    std::set<std::pair<content::GlobalRenderFrameHostId, int>> m_connections;
+    bool m_overflow = false;
+public:
+    void OnPeerConnectionAdded(content::GlobalRenderFrameHostId frame, int lid,
+                               base::ProcessId, const std::string &, const std::string &) override
+    {
+        if (m_connections.size() >= 4096) {
+            m_connections.clear();
+            m_overflow = true;
+        }
+        if (!m_overflow)
+            m_connections.emplace(frame, lid);
+    }
+
+    void OnPeerConnectionRemoved(content::GlobalRenderFrameHostId frame, int lid) override
+    {
+        m_connections.erase({frame, lid});
+    }
