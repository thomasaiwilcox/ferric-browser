+void CookieMonsterDelegateQt::ferricCookieCloneProbe(
+        CookieMonsterDelegateQt *destination, bool nonceFixture,
+        std::function<void(QWebEngineCookieStore::FerricProbeResult)> completion,
+        bool existingSource, QWebEngineCookieStore::FerricSyntheticPreflightCase syntheticCase,
+        bool opaqueFixture, bool destinationRejectFixture)
+{
+    if ((nonceFixture && opaqueFixture) || (destinationRejectFixture && (nonceFixture || opaqueFixture
+            || existingSource || syntheticCase != QWebEngineCookieStore::FerricSyntheticPreflightCase::None))
+            || destination == this
+            || !hasCookieMonster() || !destination->hasCookieMonster()
+            || !m_client || !destination->m_client || m_hasFilter || destination->m_hasFilter
+            || m_ferricProbeBusy || destination->m_ferricProbeBusy) {
+        completion({QWebEngineCookieStore::FerricProbeStatus::Unavailable, 0, 0});
+        return;
+    }
+    (new FerricCookieProbeOperation(this, destination, nonceFixture,
+                                   std::move(completion), existingSource, syntheticCase,
+                                   opaqueFixture, destinationRejectFixture))->start();
+}
