+// The browser-test fake ID must never consult an OS screen capturer. Give the
+// disposable probe deterministic synthetic frames so it can observe both the
+// real capture-device start and frame handoff without reading the user's screen.
+class FerricFakeDesktopCapturer final : public webrtc::FakeDesktopCapturer {
+ public:
+  FerricFakeDesktopCapturer() {
+    generator_.size()->set(640, 480);
+    generator_.set_return_frame(true);
+    generator_.set_provide_updated_region_hints(true);
+    generator_.set_desktop_frame_painter(&painter_);
+    set_frame_generator(&generator_);
+  }
+
+ private:
+  webrtc::BlackWhiteDesktopFramePainter painter_;
+  webrtc::PainterDesktopFrameGenerator generator_;
+};
+
@@ -933,7 +951,7 @@
   // For browser tests, to create a fake desktop capturer.
