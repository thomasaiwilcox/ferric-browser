-    capturer = std::make_unique<webrtc::FakeDesktopCapturer>();
+    capturer = std::make_unique<FerricFakeDesktopCapturer>();
     result.reset(new DesktopCaptureDevice(std::move(capturer), source.type));
     return result;
   }
