+void CookieManager::FerricProbeSeedIfEmpty(
+    const net::CookieList& cookies,
+    FerricProbeSeedIfEmptyCallback callback) {
+  // Research-only: Qt's persistent NetworkContext constructs CookieMonster
+  // whenever it supplies SessionCleanupCookieStore. The production backend
+  // would need an explicit typed store witness, not this source-pinned cast.
+  if (!session_cleanup_cookie_store_ || ferric_probe_seed_busy_ ||
+      cookies.empty() || cookies.size() > 64) {
+    std::move(callback).Run(false);
+    return;
+  }
+  size_t bytes = 0;
+  for (const auto& cookie : cookies) {
+    bytes += cookie.Name().size() + cookie.Value().size() +
+             cookie.Domain().size() + cookie.Path().size();
+    if (bytes > 512 * 1024) {
+      std::move(callback).Run(false);
+      return;
+    }
+  }
+  ferric_probe_seed_busy_ = true;
+  static_cast<net::CookieMonster*>(cookie_store_)
+      ->FerricProbeSeedIfEmptyAsync(
+          cookies,
+          base::BindOnce(
+              [](base::WeakPtr<CookieManager> self,
+                 FerricProbeSeedIfEmptyCallback completion, bool accepted) {
+                if (!self)
+                  return;
+                self->ferric_probe_seed_busy_ = false;
+                std::move(completion).Run(accepted);
+              },
+              weak_factory_.GetWeakPtr(), std::move(callback)));
+}
