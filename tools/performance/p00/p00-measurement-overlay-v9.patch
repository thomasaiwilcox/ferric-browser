+    ).split(b'\0')
+    result = {}
+    for raw in sorted(set(names) - {b''}):
+        name = os.fsdecode(raw)
+        path = ROOT / name
+        if path.is_symlink() or not path.is_file():
+            raise RuntimeError('Source inventory requires a regular file: ' + name)
+        result[name] = digest(path)
+    return result
