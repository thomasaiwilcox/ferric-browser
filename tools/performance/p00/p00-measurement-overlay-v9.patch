+  return {shape, requested, freshControl, targetCount:state.targetCount, shadowRoots:state.shadowRoots,
+    slots:state.slots, frameHops:state.frameHops, physicalButtons:state.physicalButtons,
+    clippedSentinels:state.clippedSentinels, layoutGeneration:state.layoutGeneration,
+    shadowDepthMin:state.shadowDepthMin, shadowDepthMax:state.shadowDepthMax,
