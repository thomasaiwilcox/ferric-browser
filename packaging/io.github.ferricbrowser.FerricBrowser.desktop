[Desktop Entry]
Type=Application
Version=1.0
Name=Ferric Browser
GenericName=Web Browser
Comment=Keyboard-first Qt WebEngine browser
Exec=ferric-browser open %U
Icon=io.github.ferricbrowser.FerricBrowser
Terminal=false
Categories=Network;WebBrowser;
Keywords=browser;web;keyboard;privacy;
MimeType=text/html;application/xhtml+xml;application/pdf;x-scheme-handler/http;x-scheme-handler/https;
StartupNotify=true
StartupWMClass=io.github.ferricbrowser.FerricBrowser
Actions=new-window;private-window;

[Desktop Action new-window]
Name=New Window
Exec=ferric-browser open --target window

[Desktop Action private-window]
Name=New Private Window
Exec=ferric-browser open --target private-window
