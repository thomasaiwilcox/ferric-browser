# Optional, community-maintained Omarchy integration resources for Ferric Browser.
# Build this recipe from the same release archive as the primary package.
pkgname=ferric-browser-omarchy
pkgver=0.1.0
pkgrel=1
pkgdesc='Community-maintained Omarchy integration resources for Ferric Browser'
arch=('any')
license=('GPL-3.0-or-later')
depends=('ferric-browser')
optdepends=('hyprland: compositor used by the versioned example rules'
            'walker: optional launcher integration')
source=("ferric-browser-${pkgver}.tar.gz")
sha256sums=('SKIP')

package() {
  cd "${srcdir}/ferric-browser-${pkgver}"
  install -Dm755 packaging/omarchy/usr/bin/ferric-browser-omarchy-doctor \
    "${pkgdir}/usr/bin/ferric-browser-omarchy-doctor"
  install -Dm755 packaging/omarchy/usr/bin/ferric-browser-omarchy-query-tabs \
    "${pkgdir}/usr/bin/ferric-browser-omarchy-query-tabs"
  install -Dm755 packaging/omarchy/usr/bin/ferric-browser-omarchy-activate-tab \
    "${pkgdir}/usr/bin/ferric-browser-omarchy-activate-tab"
  install -Dm644 packaging/omarchy/share/ferric-browser-omarchy/launcher-actions.toml \
    "${pkgdir}/usr/share/ferric-browser-omarchy/launcher-actions.toml"
  install -Dm644 packaging/omarchy/share/ferric-browser-omarchy/templates/theme.toml \
    "${pkgdir}/usr/share/ferric-browser-omarchy/templates/theme.toml"
  install -Dm644 packaging/omarchy/share/ferric-browser-omarchy/examples/hyprland/ferric-browser-0.51.conf \
    "${pkgdir}/usr/share/ferric-browser-omarchy/examples/hyprland/ferric-browser-0.51.conf"
  install -Dm644 packaging/omarchy/share/ferric-browser-omarchy/examples/hyprland/ferric-browser-0.55.lua \
    "${pkgdir}/usr/share/ferric-browser-omarchy/examples/hyprland/ferric-browser-0.55.lua"
  install -Dm644 packaging/omarchy/README.md \
    "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}
