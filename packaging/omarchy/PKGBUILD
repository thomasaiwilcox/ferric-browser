# Optional, community-maintained Omarchy integration resources for RustBrowser.
# Build this recipe from the same release archive as the primary package.
pkgname=rustbrowser-omarchy
pkgver=0.1.0
pkgrel=1
pkgdesc='Community-maintained Omarchy integration resources for RustBrowser'
arch=('any')
license=('MIT' 'Apache-2.0')
depends=('rustbrowser')
optdepends=('hyprland: compositor used by the versioned example rules'
            'walker: optional launcher integration')
source=("rustbrowser-${pkgver}.tar.gz")
sha256sums=('SKIP')

package() {
  cd "${srcdir}/rustbrowser-${pkgver}"
  install -Dm755 packaging/omarchy/usr/bin/rustbrowser-omarchy-doctor \
    "${pkgdir}/usr/bin/rustbrowser-omarchy-doctor"
  install -Dm755 packaging/omarchy/usr/bin/rustbrowser-omarchy-query-tabs \
    "${pkgdir}/usr/bin/rustbrowser-omarchy-query-tabs"
  install -Dm755 packaging/omarchy/usr/bin/rustbrowser-omarchy-activate-tab \
    "${pkgdir}/usr/bin/rustbrowser-omarchy-activate-tab"
  install -Dm644 packaging/omarchy/share/rustbrowser-omarchy/launcher-actions.toml \
    "${pkgdir}/usr/share/rustbrowser-omarchy/launcher-actions.toml"
  install -Dm644 packaging/omarchy/share/rustbrowser-omarchy/templates/theme.toml \
    "${pkgdir}/usr/share/rustbrowser-omarchy/templates/theme.toml"
  install -Dm644 packaging/omarchy/share/rustbrowser-omarchy/examples/hyprland/rustbrowser-0.51.conf \
    "${pkgdir}/usr/share/rustbrowser-omarchy/examples/hyprland/rustbrowser-0.51.conf"
  install -Dm644 packaging/omarchy/share/rustbrowser-omarchy/examples/hyprland/rustbrowser-0.55.lua \
    "${pkgdir}/usr/share/rustbrowser-omarchy/examples/hyprland/rustbrowser-0.55.lua"
  install -Dm644 packaging/omarchy/README.md \
    "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}
